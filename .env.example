# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this to .env and fill in your actual API keys

# NODE ENVIRONMENT
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================================================
# AI API KEYS (Backend Only - NEVER expose to frontend)
# ============================================================================

# Google Gemini API
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_actual_anthropic_api_key_here

# OpenAI API (GPT-4, GPT-5, Astra)
OPENAI_API_KEY=your_actual_openai_api_key_here
OPENAI_ORG_ID=your_org_id_optional

# DeepSeek / Together AI API (Multimodal Free)
TOGETHER_API_KEY=your_actual_together_api_key_here

# Meta Llama (Optional)
REPLICATE_API_KEY=your_actual_replicate_api_key_here

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_os
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
JWT_EXPIRY=24h

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# AI MODEL CONFIGURATION
# ============================================================================

# Default model for auto-routing
DEFAULT_MODEL=gemini-3.8-flash

# Model request timeout (ms)
AI_REQUEST_TIMEOUT=60000

# Enable/Disable models
ENABLE_GEMINI=true
ENABLE_CLAUDE=true
ENABLE_OPENAI=true
ENABLE_DEEPSEEK=true
ENABLE_LLAMA=false

# Max tokens per request
MAX_INPUT_TOKENS=100000
MAX_OUTPUT_TOKENS=8000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log Level: error, warn, info, debug
LOG_LEVEL=info

# Enable structured JSON logging
JSON_LOGS=true

# Optional: Sentry error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================================================
# STORAGE & UPLOADS
# ============================================================================

# File upload directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=50mb

# Optional: AWS S3 for production
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# FRONTEND CONFIG
# ============================================================================

# Backend API URL (for frontend to call)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Enable dev tools
VITE_DEBUG=false
